# Copy to .env and fill in. .env is gitignored.

# --- Storage -----------------------------------------------------------------
# Compose overrides this for the app container; this value is for host-side runs.
DATABASE_URL=postgresql+psycopg://jobs:jobs@localhost:5432/jobs
POSTGRES_USER=jobs
POSTGRES_PASSWORD=jobs
POSTGRES_DB=jobs

# --- Stage 1: collection -----------------------------------------------------
# NOTE (ADR-0005): searches and the operational settings below are now managed
# from the web UI (Schedules and Settings pages) and stored in the database.
# The values here are the SEED used on first migration and the fallback for a
# fresh, un-migrated deployment. Editing them after first run has no effect —
# change them in the UI instead.
#
# JSON array of search specs. One entry per collector invocation, because
# country_indeed takes a single country per call (design D14).
#   term        search string
#   location    board-specific location string, or null
#   country     maps to country_indeed; governs Indeed only
#   is_remote   restrict to remote listings
#   sites       subset of ["indeed","linkedin"] (design D11)
SEARCHES=[{"term":"data engineer","location":"Cairo, Egypt","country":"egypt"},{"term":"data engineer","location":"Egypt","country":"egypt","is_remote":true}]

RESULTS_PER_SEARCH=50
HOURS_OLD=72
# Design §9.3 — raising this is the first remedy for restriction
REQUEST_DELAY_SECONDS=10
PROXIES=[]
# LinkedIn omits descriptions from list results; fetching one costs an extra
# request per posting (slower) but is what the detail view and scorer need.
LINKEDIN_FETCH_DESCRIPTION=true

# --- Stage 3: scoring --------------------------------------------------------
# Ollama runs on the host; compose points the container at host.docker.internal
OLLAMA_HOST=http://localhost:11434
SCORING_MODEL=qwen2.5:7b-instruct
CV_PATH=data/cv.txt
# Coarse title pre-filter (design D6). Empty disables.
TITLE_INCLUDE_PATTERN=
TITLE_EXCLUDE_PATTERN=(?i)\b(senior manager|director|vp|head of)\b

# --- Stage 4: publication ----------------------------------------------------
# After ADR-0004 publication is a state transition in the local database, not a
# write to any external service — so there are no delivery credentials here.
# Design D7 — permissive at outset, tighten after a week of calibration
PUBLISH_THRESHOLD=60

# --- Triage interface (ADR-0004) ---------------------------------------------
WEB_HOST=0.0.0.0
WEB_PORT=8000

# --- Scheduling --------------------------------------------------------------
SCHEDULE_HOUR=6
SCHEDULE_MINUTE=0
TIMEZONE=Africa/Cairo
